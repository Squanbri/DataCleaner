@model GenerateSampleViewModel
@{
    ViewData["Title"] = "Генератор CSV";
}

<h1>Генератор тестового CSV</h1>
<p class="muted">
    Создаёт выгрузку «как из CRM»: часть телефонов и ФИО в разных форматах,
    дубли одного человека и немного заведомо битых строк.
</p>

<article>
    <form asp-action="Generate" method="post">
        <div asp-validation-summary="All"></div>

        <label asp-for="BasePeople"></label>
        <input asp-for="BasePeople" type="number" min="10" max="5000" />

        <label asp-for="DirtyCopyPercent"></label>
        <input asp-for="DirtyCopyPercent" type="number" min="0" max="100" />
        <small class="muted">У этой доли эталонов появятся 1-3 испорченные копии (другие форматы телефона/ФИО/даты).</small>

        <label asp-for="GarbagePercent"></label>
        <input asp-for="GarbagePercent" type="number" min="0" max="20" />
        <small class="muted">Доля мусора: короткий телефон, email без @@, 31.02, пустое ФИО.</small>

        <label asp-for="Seed"></label>
        <input asp-for="Seed" type="number" />

        <div class="grid">
            <button type="submit" name="download" value="customers">Скачать customers.csv</button>
            <button type="submit" name="download" value="truth" class="secondary">Скачать customers.truth.csv</button>
        </div>
    </form>
</article>

<article>
    <h3>Что попадает в файл</h3>
    <ul>
        <li>Колонки: <code>external_id;full_name;phone;email;birth_date;city</code></li>
        <li>Разделитель <code>;</code>, UTF-8</li>
        <li>Грязные копии: <code>8 (915) …</code>, капс, двойные пробелы, <code>ё/е</code>, даты <code>dd.MM.yyyy</code> / <code>dd/MM/yyyy</code></li>
        <li><code>customers.truth.csv</code> — эталон групп дублей (в сервис не загружается)</li>
    </ul>
    <p>
        Дальше: <a asp-controller="Imports" asp-action="Index">загрузите CSV на главной</a>
        или возьмите готовый <code>samples/customers.csv</code> из репозитория.
    </p>
</article>
