@model IReadOnlyList<ImportBatchDto>
@{
    ViewData["Title"] = "Загрузки";
}

<h1>Загрузки</h1>

<article>
    <h2>Новый файл</h2>
    <p class="muted">
        Нет своего CSV?
        <a asp-controller="Samples" asp-action="Generate">Сгенерируйте тестовый файл с битыми данными</a>.
        Загрузка отвечает сразу (202), очистка идёт в фоне через RabbitMQ.
    </p>
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All"></div>
        <label>
            CSV
            <input type="file" name="file" accept=".csv,text/csv" required />
        </label>
        <button type="submit">Загрузить и очистить</button>
    </form>
</article>

<figure>
    <table>
        <thead>
        <tr>
            <th>Id</th>
            <th>Файл</th>
            <th>Статус</th>
            <th>Строк</th>
            <th>Создан</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="muted">Пока нет загрузок. Возьмите <code>samples/customers.csv</code>.</td></tr>
        }
        @foreach (var batch in Model)
        {
            var inProgress = batch.Status is ImportStatus.Pending or ImportStatus.Processing;
            <tr>
                <td>@batch.Id</td>
                <td>@batch.FileName</td>
                <td>
                    @batch.Status
                    @if (inProgress)
                    {
                        <span class="muted">(идёт…)</span>
                    }
                </td>
                <td>@batch.TotalRows</td>
                <td>@batch.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><a asp-action="Details" asp-route-id="@batch.Id">@(inProgress ? "Статус" : "Отчёт")</a></td>
            </tr>
        }
        </tbody>
    </table>
</figure>

@if (Model.Any(b => b.Status is ImportStatus.Pending or ImportStatus.Processing))
{
    <meta http-equiv="refresh" content="3" />
}
